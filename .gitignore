# --- Build output ---
out/
build/
cmake-build-*/

# --- ReXGlue generated code (regenerated by codegen during build) ---
# Keep rexglue.cmake (scaffolded) but ignore codegen outputs.
generated/default/
generated/*/sources.cmake
generated/*/dll_targets.cmake
generated/*/codegen.d
generated/*/codegen.build.stamp
generated/*/*.cpp
generated/*/*.h
generated/*/*.hpp
!generated/rexglue.cmake
!generated/.gitkeep

# --- ReXGlue SDK (cloned via setup script, not tracked here) ---
thirdparty/rexglue-sdk/

# --- Disc images (copyrighted, do NOT commit) ---
disc/
*.iso
*.xiso
*.god
*.ciso

# --- Game assets (copyrighted, extracted from ISO; do NOT commit) ---
game/*
!game/.gitkeep
!game/README.md

# --- IDE / editor ---
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates
[Cc]ache/
*.cache

# --- OS cruft ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Logs / runtime artifacts ---
*.log
*.pdb
*.ilk
*.exp
*.lib
*.exe
*.dll

# --- Debug dumps / temp artifacts ---
build_output.txt
run_output.txt
default.idc
default_basefile.bin
sdk_texture_cache_diff*.txt
vp6_luma_guest_ram_*.raw
vp6_luma_guest_ram_*.png
vp6_pixel_shader_dxbc.txt
xextool_v6.6.zip
xextool_v6.6/
test/minidumps/
test/run_*.log
test/headless_test_run.log
tools/__pycache__/
__pycache__/
*.pyc

# --- Launcher C# build output ---
launcher/**/bin/
launcher/**/obj/
launcher/**/*.user
launcher/**/*.suo
launcher_test/
launcher-release/

# --- Source icon assets (keep ICO, ignore PNG source) ---
!launcher/icon.ico
!metadata/icon.ico
metadata/icon.png

# --- Third-party reference source (optional, not needed for runtime) ---
tools/Gibbed.Visceral/
