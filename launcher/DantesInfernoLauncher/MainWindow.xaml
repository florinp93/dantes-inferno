<Window x:Class="DantesInferno.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dante's Inferno" Height="620" Width="980"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0">
            <Image x:Name="BannerImage" Stretch="UniformToFill" Margin="0" />
        </Border>

        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0">
            <TabControl x:Name="MainTabControl" Margin="15">

                <TabItem Header="PLAY">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ready to enter the Nine Circles." FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PlayStatusText" Text="Game files found." FontSize="14" Margin="0,0,0,20" />
                            <Button x:Name="PlayButton" Content="PLAY" FontSize="36" Padding="20,10" Width="200" Height="80" Click="PlayButton_Click" />
                            <Button Content="EXIT" FontSize="14" Padding="10,5" Width="120" Margin="0,15,0,0" Click="ExitButton_Click" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,10">
                            <TextBlock x:Name="PlayNoteText" Text="" FontSize="11" Opacity="0.7" Margin="0,5" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button Content="Support the Developer" Click="SupportButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Grid.Row="3" Text="Version: 0.3.2-alpha" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                    </Grid>
                </TabItem>

                <TabItem Header="SETTINGS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                        <StackPanel Margin="10">

                            <GroupBox Header="Graphics Quality">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Resolution Scale:" />
                                    <ComboBox x:Name="ResScaleCombo" Grid.Row="0" Grid.Column="1" Margin="0,2" />

                                    <Label Grid.Row="1" Grid.Column="0" Content="Anti-Aliasing:" />
                                    <ComboBox x:Name="AAModeCombo" Grid.Row="1" Grid.Column="1" Margin="0,2" />

                                    <Label Grid.Row="2" Grid.Column="0" Content="Texture Filtering:" />
                                    <ComboBox x:Name="AnisoCombo" Grid.Row="2" Grid.Column="1" Margin="0,2" />

                                    <CheckBox x:Name="FullscreenCheck" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Fullscreen" Margin="0,8,0,0" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Controls">
                                <StackPanel Margin="10">
                                    <CheckBox x:Name="ControllerFixCheck" Content="Use controller (Xbox / PlayStation controllers)" Margin="0,3" />

                                    <Grid Margin="0,8,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Button glyphs:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="GlyphFamilyCombo" Grid.Column="1" IsEnabled="False" SelectedIndex="0" ToolTip="Select controller button glyph style">
                                            <ComboBoxItem Content="Xbox 360" />
                                            <ComboBoxItem Content="PlayStation" />
                                        </ComboBox>
                                        <Border Grid.Column="1" Background="#0078D7" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,4" IsHitTestVisible="True">
                                            <TextBlock Text="Coming soon" FontWeight="Bold" Foreground="White" FontSize="11" />
                                        </Border>
                                    </Grid>

                                    <CheckBox x:Name="PlayStationGlyphsCheck" Content="Use PlayStation button glyphs (DualSense)" IsChecked="False" Margin="0,3" Visibility="Collapsed" ToolTip="Replaces Xbox 360 button prompts (A/B/X/Y) with PlayStation equivalents (Cross/Circle/Square/Triangle)" />
                                    <CheckBox x:Name="LoggingEnabledCheck" Content="Enable logging (for crash reports)" IsChecked="False" Margin="0,3" />
                                </StackPanel>
                            </GroupBox>

                            <TextBlock Text="Settings are applied when you click PLAY." FontSize="11" Opacity="0.6" Margin="0,5,0,10" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Button Content="Reset to Recommended" Width="180" Click="ApplyRecommended_Click" Margin="0,0,10,0" />
                                <Button Content="Save Settings" Width="120" Click="SaveSettings_Click" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="UPDATES">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Check for Updates" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBlock x:Name="UpdateVersionText" Grid.Row="1" Text="Installed version: 0.3.2-alpha" Margin="0,5" />
                        <Button x:Name="CheckUpdatesButton" Grid.Row="2" Content="Check for Updates" HorizontalAlignment="Left" Width="150" Margin="0,10" Click="CheckUpdates_Click" />
                        <TextBox x:Name="UpdateStatusText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundPanel}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10" />
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</Window>
