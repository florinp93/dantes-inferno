<Window x:Class="DantesInferno.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hell's Gate Launcher - Dante's Inferno" Height="620" Width="980"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0">
            <Image x:Name="BannerImage" Stretch="UniformToFill" Margin="0" />
        </Border>

        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0">
            <TabControl x:Name="MainTabControl" Margin="15">

                <TabItem Header="PLAY">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ready to enter the Nine Circles." FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PlayStatusText" Text="Game files found." FontSize="14" Margin="0,0,0,20" />
                            <Button x:Name="PlayButton" Content="PLAY" FontSize="36" Padding="20,10" Width="200" Height="80" Click="PlayButton_Click" />
                            <Button Content="EXIT" FontSize="14" Padding="10,5" Width="120" Margin="0,15,0,0" Click="ExitButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="PlayNoteText" Grid.Row="2" Text="Launching with the tested default settings." FontSize="11" Opacity="0.7" Margin="0,10" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button Content="Support the Developer" Click="SupportButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Grid.Row="3" Text="Version: 0.1.0.0" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                    </Grid>
                </TabItem>

                <TabItem Header="SETTINGS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">

                            <GroupBox Header="Game Files">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Game Data:" />
                                    <TextBox x:Name="GameDataTextBox" Grid.Column="1" IsReadOnly="True" />
                                    <Button Grid.Column="2" Content="Browse" Width="80" Margin="5,0,0,0" Click="BrowseGameData_Click" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Graphics (coming soon)">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Resolution:" />
                                    <ComboBox x:Name="ResolutionCombo" Grid.Row="0" Grid.Column="1" />

                                    <Label Grid.Row="1" Grid.Column="0" Content="Frame Rate:" />
                                    <ComboBox x:Name="FrameCapCombo" Grid.Row="1" Grid.Column="1" />

                                    <CheckBox x:Name="FullscreenCheck" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Fullscreen" Margin="0,5" />

                                    <Label Grid.Row="3" Grid.Column="0" Content="Texture Filtering:" />
                                    <ComboBox x:Name="AnisoCombo" Grid.Row="3" Grid.Column="1" />

                                    <Label Grid.Row="4" Grid.Column="0" Content="Anti-Aliasing:" />
                                    <ComboBox x:Name="AAModeCombo" Grid.Row="4" Grid.Column="1" />

                                    <CheckBox x:Name="MsaaCheck" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Use MSAA" Margin="0,5" />

                                    <Label Grid.Row="6" Grid.Column="0" Content="Resolution Scale:" />
                                    <ComboBox x:Name="ResScaleCombo" Grid.Row="6" Grid.Column="1" IsEnabled="False" ToolTip="Disabled while a rendering bug is being fixed." />
                                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="* Resolution scale is currently disabled." FontSize="11" Opacity="0.6" Margin="0,3" />

                                    <CheckBox x:Name="AutoOptimizationsCheck" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Content="Use recommended settings when available" Margin="0,10" />
                                    <Button Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Content="Reset to Recommended" HorizontalAlignment="Left" Width="180" Click="ApplyRecommended_Click" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Controls &amp; Fixes (coming soon)">
                                <StackPanel Margin="10">
                                    <CheckBox x:Name="ControllerFixCheck" Content="Use SDL for controller support" />
                                    <CheckBox x:Name="SharpenCheck" Content="Sharpen visuals (FXAA Extreme + 16x aniso)" />
                                    <CheckBox x:Name="CommonFixesCheck" Content="Use ROV graphics fix for stability" />
                                </StackPanel>
                            </GroupBox>

                            <TextBlock Text="* These settings are placeholders for a future update. Play uses the tested defaults." FontSize="11" Opacity="0.6" Margin="0,0,0,10" />

                            <Button Content="Save Settings" HorizontalAlignment="Left" Width="120" Click="SaveSettings_Click" />

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="UPDATES">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Auto-Updater" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBlock x:Name="UpdateVersionText" Grid.Row="1" Text="Installed version: 0.1.0.0" Margin="0,5" />
                        <Button x:Name="CheckUpdatesButton" Grid.Row="2" Content="Check for Updates" HorizontalAlignment="Left" Width="150" Margin="0,10" Click="CheckUpdates_Click" />
                        <TextBox x:Name="UpdateStatusText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundPanel}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10" />
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</Window>
