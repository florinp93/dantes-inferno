<Window x:Class="DantesInferno.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dante's Inferno - Uninstaller" Height="380" Width="520"
        MinHeight="340" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DANTE'S INFERNO - UNINSTALLER" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,15" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="This will remove Dante's Inferno from your computer:" FontSize="14" Margin="0,0,0,10" />
            <TextBlock Text="- Game executable and runtime files" Margin="20,2" FontSize="13" />
            <TextBlock Text="- Extracted game data (ISO contents)" Margin="20,2" FontSize="13" />
            <TextBlock Text="- Launcher and configuration files" Margin="20,2" FontSize="13" />
            <TextBlock Text="- Desktop shortcut" Margin="20,2" FontSize="13" />
            <CheckBox x:Name="KeepSavesCheck" Content="Keep saved games and logs" IsChecked="True" Margin="0,15,0,0" FontSize="13" />
            <TextBlock Text="WARNING: This cannot be undone." FontSize="12" Foreground="#CC6666" Margin="0,15,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="UninstallButton" Content="Uninstall" Width="100" Click="UninstallButton_Click" />
        </StackPanel>
    </Grid>
</Window>
