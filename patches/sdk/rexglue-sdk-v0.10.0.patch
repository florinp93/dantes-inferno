+      " uint32_t _lvewx_idx = 3 - (({} & 0xF) >> 2);"
+      " {}.u32[_lvewx_idx] = _lvewx_w; }}",
+      ctx.ea(), ctx.ea(), ctx.v(ctx.insn.operands[0]));
+  return true;
+}
