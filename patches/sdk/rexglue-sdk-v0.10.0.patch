+bool build_lvebx(BuilderContext& ctx) {
+  // lvebx: Load Vector Element Byte Indexed
+  // Loads a single byte into one element of vD, leaving other elements unchanged.
+  // The element is selected by bits 28-31 of the effective address (which byte within
+  // the 16-byte block). On PPC (big-endian), element 0 is at the lowest address.
+  // On the host (little-endian), element 0 is at the highest address, so we reverse
+  // the index: host_element = 15 - (ea & 0xF).
+  emitVectorEA(ctx);
+  ctx.println(
+      "\t{{ uint8_t _lvebx_b = REX_LOAD_U8({});"
+      " uint32_t _lvebx_idx = 15 - ({} & 0xF);"
+      " {}.u8[_lvebx_idx] = _lvebx_b; }}",
+      ctx.ea(), ctx.ea(), ctx.v(ctx.insn.operands[0]));
+  return true;
+}
+
+bool build_lvehx(BuilderContext& ctx) {
+  // lvehx: Load Vector Element Halfword Indexed
+  // Loads a single 16-bit halfword into one element of vD, leaving other elements
+  // unchanged. The element is selected by bits 27-31 of the effective address (which
+  // halfword within the 16-byte block). On PPC (big-endian), element 0 is at the
+  // lowest address. On the host (little-endian), element 0 is at the highest address,
+  // so we reverse the index: host_element = 7 - ((ea & 0xF) >> 1).
+  // The loaded halfword is byte-swapped from big-endian to host-endian via REX_LOAD_U16.
+  emitVectorEA(ctx, "0x1");
+  ctx.println(
+      "\t{{ uint16_t _lvehx_h = REX_LOAD_U16({});"
+      " uint32_t _lvehx_idx = 7 - (({} & 0xF) >> 1);"
+      " {}.u16[_lvehx_idx] = _lvehx_h; }}",
+      ctx.ea(), ctx.ea(), ctx.v(ctx.insn.operands[0]));
+  return true;
+}
+
+bool build_lvewx(BuilderContext& ctx) {
+  // lvewx: Load Vector Element Word Indexed
+  // Loads a single 32-bit word into one element of vD, leaving other elements unchanged.
+  // The element is selected by bits 28-31 of the effective address (which word within the
+  // 16-byte aligned block). On PPC (big-endian), element 0 is at the lowest address.
