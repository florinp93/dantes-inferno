+void MergeTopLevelMidAsmHooks(const toml::table& manifest, BinaryConfig& binary) {
+  auto* hooks = manifest["midasm_hook"].as_array();
+  if (!hooks)
+    return;
+  for (const auto& entry : *hooks) {
+    auto* table = entry.as_table();
+    if (!table)
+      continue;
+    auto address_opt = (*table)["address"].value<uint32_t>();
+    auto name_opt = (*table)["name"].value<std::string>();
+    if (!address_opt || !name_opt)
+      continue;
+    MidAsmHook hook;
+    hook.name = *name_opt;
+    if (auto regs = (*table)["registers"].as_array()) {
+      for (const auto& reg : *regs) {
+        if (auto s = reg.value<std::string>())
+          hook.registers.push_back(*s);
+      }
+    }
+    hook.ret = (*table)["return"].value_or(false);
+    hook.returnOnTrue = (*table)["return_on_true"].value_or(false);
+    hook.returnOnFalse = (*table)["return_on_false"].value_or(false);
+    hook.jumpAddress = (*table)["jump_address"].value_or(0u);
+    hook.jumpAddressOnTrue = (*table)["jump_address_on_true"].value_or(0u);
+    hook.jumpAddressOnFalse = (*table)["jump_address_on_false"].value_or(0u);
+    hook.afterInstruction = (*table)["after_instruction"].value_or(false);
+    binary.recompiler.midAsmHooks.insert_or_assign(*address_opt, std::move(hook));
+  }
+}
+
