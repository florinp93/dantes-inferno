+//=============================================================================
+// Data Section Function Pointer Scan: scan non-executable sections for
+// dwords that point into executable sections. These are function pointers
+// stored in vtables, callback arrays, and raw data tables that the RTTI
+// vtable scanner misses.
+//=============================================================================
+void dataSectionFunctionPointerScan(CodegenContext& ctx) {
+  auto& graph = ctx.graph;
+  const auto& binary = ctx.binary();
+
+  // Build set of existing function entry points
+  std::unordered_set<uint32_t> existingFunctions;
+  for (const auto& [addr, node] : graph.functions()) {
+    existingFunctions.insert(addr);
+  }
+
+  // Collect all executable section ranges
+  struct ExecRange {
+    uint32_t start, end;
+  };
+  std::vector<ExecRange> execRanges;
+  for (const auto& sec : binary.sections()) {
+    if (sec.executable) {
+      execRanges.push_back({sec.baseAddress, sec.baseAddress + sec.size});
+    }
+  }
+
+  if (execRanges.empty()) {
+    REXCODEGEN_WARN("dataSectionFunctionPointerScan: no executable sections found");
+    return;
+  }
+
+  auto isExecutableAddr = [&](uint32_t addr) -> bool {
+    for (const auto& r : execRanges) {
+      if (addr >= r.start && addr < r.end)
+        return true;
+    }
+    return false;
+  };
+
+  // Also get the import/export range to exclude thunks
+  uint32_t importStart = binary.importThunkTableStart();
+
+  size_t foundCount = 0;
+
+  // Scan all non-executable sections for 4-byte aligned dwords
+  for (const auto& sec : binary.sections()) {
+    if (sec.executable)
+      continue;
+    if (!sec.data || sec.size < 4)
+      continue;
+
+    REXCODEGEN_TRACE("dataSectionFunctionPointerScan: scanning section '{}' "
+                     "(0x{:08X}-0x{:08X}, {} bytes)",
+                     sec.name, sec.baseAddress, sec.baseAddress + sec.size, sec.size);
+
+    for (size_t offset = 0; offset + 4 <= sec.size; offset += 4) {
+      uint32_t value = load_and_swap<uint32_t>(sec.data + offset);
+
+      // Skip null and obviously non-address values
+      if (value == 0 || value == 0xFFFFFFFF)
+        continue;
+
+      // Must be 4-byte aligned (PPC instruction alignment)
+      if (value & 0x3)
+        continue;
+
+      // Must point into an executable section
+      if (!isExecutableAddr(value))
+        continue;
+
+      // Skip import/export thunk range
+      if (importStart != 0 && value >= importStart)
+        continue;
+
+      // Skip if already a known function
+      if (existingFunctions.count(value))
+        continue;
+
+      // Skip null padding in code (check if the target instruction is 0x00000000)
+      const uint8_t* targetData = binary.translate(value);
+      if (targetData) {
+        uint32_t targetInsn = load_and_swap<uint32_t>(targetData);
+        if (targetInsn == 0x00000000 || targetInsn == 0xFFFFFFFF)
+          continue;
+      }
+
+      // Register as a function pointer target
+      graph.addFunction(value, 4, FunctionAuthority::VTABLE, true);
+      existingFunctions.insert(value);
+      foundCount++;
+
+      REXCODEGEN_TRACE("dataSectionFunctionPointerScan: found 0x{:08X} in '{}' at offset 0x{:X}",
+                       value, sec.name, offset);
+    }
+  }
+
+  REXCODEGEN_INFO("dataSectionFunctionPointerScan: found {} new function pointer targets",
+                  foundCount);
+
+  // Run discovery iterations for the newly found functions
+  if (foundCount > 0) {
+    size_t iteration = 0;
+    const size_t maxIterations = REXCVAR_GET(max_vtable_iterations);
+
+    while (iteration < maxIterations) {
+      iteration++;
+
+      auto knownFunctions = buildKnownFunctions(graph);
+      if (discoverPendingFunctions(ctx, knownFunctions) == 0)
+        break;
+
+      size_t currentCount = graph.functionCount();
+      if (currentCount == existingFunctions.size())
+        break;
+    }
+  }
+}
